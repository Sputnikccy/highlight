{
  "manifest_version": 3,
  "name": "Highlight",
  "version": "0.8.0",
  "description": "Save, organize, and revisit context-rich highlights with smart views and bulk actions.",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "action": {
    "default_title": "Open Highlight Library"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
