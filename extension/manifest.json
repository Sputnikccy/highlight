{
  "manifest_version": 3,
  "name": "Highlight",
  "version": "0.1.0",
  "description": "Create persistent highlights in ChatGPT conversations.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
