{
  "manifest_version": 3,
  "name": "Highlight",
  "version": "1.0.0",
  "description": "Save, organize, and reliably revisit context-rich highlights at Library scale.",
  "icons": {
    "16": "icons/highlight-16.png",
    "32": "icons/highlight-32.png",
    "48": "icons/highlight-48.png",
    "128": "icons/highlight-128.png"
  },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "action": {
    "default_title": "Open Highlight Library",
    "default_icon": {
      "16": "icons/highlight-16.png",
      "32": "icons/highlight-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
